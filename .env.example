# ==============================================================================
# AGEIS-X ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel)
# ------------------------------------------------------------------------------
# Public API URL pointing to the deployed FastAPI backend on Render.
# When deploying the Next.js frontend to Vercel, set this in:
# Project Settings -> Environment Variables -> NEXT_PUBLIC_API_URL
# Example: NEXT_PUBLIC_API_URL=https://ageis-x-api.onrender.com
# For local development, leave unset or default to http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render Web Service)
# ------------------------------------------------------------------------------
# Comma-separated list of additional allowed CORS origins.
# Render automatically allows https://*.vercel.app and localhost origins.
# If using a custom production domain (e.g. https://ageis-x.com), add it here:
# CORS_ORIGINS=https://ageis-x.com,https://www.ageis-x.com
CORS_ORIGINS=

# Set to False in production
DEBUG=False
